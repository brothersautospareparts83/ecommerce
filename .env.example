# Brothers Auto Spare Parts — environment variables. Copy to .env.local. Never commit real values.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Business contact (must be set by owner; no invented defaults) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=            # international format, e.g. 255XXXXXXXXX
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=

# --- Supabase (required from Phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=              # SERVER ONLY

# --- AI (Phase 8; optional) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=                      # SERVER ONLY
AI_DAILY_LIMIT_PER_USER=30

# --- Automotive catalog provider (Phase 7; optional, licensed) ---
CATALOG_PROVIDER=manual
CATALOG_API_KEY=

# --- Product image source (Phase 6; optional, licensed) ---
IMAGE_SOURCE_PROVIDER=none
IMAGE_SOURCE_API_KEY=

# --- Payments (Phase 10; optional) ---
PAYMENT_PROVIDER=manual
MPESA_API_KEY=
MPESA_WEBHOOK_SECRET=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_WEBHOOK_SECRET=
TIGO_API_KEY=
TIGO_WEBHOOK_SECRET=

# --- Email (optional) ---
EMAIL_PROVIDER=none
RESEND_API_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=

# --- Neon Postgres (Phase 2) ---
DATABASE_URL=                          # pooled connection (app runtime)
DATABASE_URL_UNPOOLED=                 # direct connection (migrations, tests)

# --- Neon Auth (Phase 3) ---
NEON_AUTH_BASE_URL=                     # from Neon console > Auth
NEON_AUTH_COOKIE_SECRET=                # 32+ random chars: openssl rand -base64 32

# Parts assistant: optional. Without a key the assistant answers from the catalogue alone.
GEMINI_API_KEY=
GEMINI_MODEL=              # optional, default gemini-3.5-flash-lite
